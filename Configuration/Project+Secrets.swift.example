import Foundation
import ProjectDescription

// Local configuration only. Never commit populated credentials.
public extension Project {
    enum Secrets {
        public static let appInfoPList: [String: Plist.Value] = [
            "CFBundleDisplayName": "Dear Diary",
            "UILaunchScreen": [:],
            // Copy values from your Firebase iOS app configuration for real sign-in.
            "API_KEY": "CONFIGURE_FIREBASE_API_KEY",
            "GOOGLE_APP_ID": "CONFIGURE_FIREBASE_APP_ID",
            "GCM_SENDER_ID": "CONFIGURE_FIREBASE_SENDER_ID",
            "PROJECT_ID": "CONFIGURE_FIREBASE_PROJECT_ID",
            "BUNDLE_ID": "com.bibumtiger.DearDiary.App",
            "CLIENT_ID": "CONFIGURE_GOOGLE_CLIENT_ID",
            "CFBundleURLTypes": [["CFBundleURLSchemes": ["CONFIGURE_REVERSED_GOOGLE_CLIENT_ID"]]],
            // Development-only: the current app reads these from its Info.plist.
            "OpenAIToken": "CONFIGURE_DEVELOPMENT_TOKEN",
            "AssistantID": "CONFIGURE_ASSISTANT_ID",
        ]
        public static let testInfoPList: [String: Plist.Value] = [:]
    }
}
